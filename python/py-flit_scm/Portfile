# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                py-flit_scm
version             1.7.0
revision            1

categories-append   devel
supported_archs     noarch
platforms           {darwin any}
license             MIT
maintainers         nomaintainer

description         A PEP 518 build backend that uses setuptools_scm to \
                    generate a version file from your version control system, \
                    then flit to build the package.
long_description    {*}${description}

homepage            https://pypi.org/project/flit-scm

checksums           rmd160  611240054ec3a5210824febb66237be762104458 \
                    sha256  961bd6fb24f31bba75333c234145fff88e6de0a90fc0f7e5e7c79deca69f6bb2 \
                    size    2405

python.versions     310 311 312 313

if {${name} ne ${subport}} {
    # flit_scm 1.7.0 (the latest release; upstream is inactive since 2022)
    # pins flit-core~=3.5 in both its build requirements and its runtime
    # dependencies, but py-flit_core is 4.x. With the pin, flit_scm can't
    # build itself, and ports built with it (py-exceptiongroup) fail with
    # "Unmet dependencies: flit_scm -> flit-core~=3.5". flit_scm only
    # re-exports flit_core.buildapi, which 4.x still provides.
    post-patch {
        reinplace "s|\"flit-core~=3.5\"|\"flit-core>=3.5\"|g" ${worksrcpath}/pyproject.toml
    }

    depends_lib-append \
                    port:py${python.version}-flit_core \
                    port:py${python.version}-setuptools_scm
}
